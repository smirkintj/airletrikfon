# Copy to .env.local. Everything is optional for local use: without Neon settings, bills
# are stored in .data/ on disk and there is no login (this mode refuses to run on Vercel).

# Claude API key. Without it, TNB and Air Selangor bills still work (built-in parsers);
# other layouts and the Ask page need it.
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to use the app.
ALLOWED_EMAIL=

# ── Neon (written by `neon deploy` / `neon env pull`) ──────────────────────────────────
DATABASE_URL=
NEON_AUTH_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Not provided by Neon: generate with `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
