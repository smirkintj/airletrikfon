# Copy to .env.local. Everything is optional for local use.

# Claude API key (console.anthropic.com). Without it, only TNB bills can be read (built-in
# parser) and the Ask page is disabled.
ANTHROPIC_API_KEY=

# Supabase: required when deployed. Without these, bills are stored in .data/ on disk and
# there is no login (local mode refuses to run on Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed to sign in.
ALLOWED_EMAIL=
